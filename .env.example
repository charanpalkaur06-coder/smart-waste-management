# Figma API — never commit .env (gitignored via *.local)
# Create token: https://www.figma.com/settings → Security → Personal access tokens
# Scopes: file_content:read, file_variables:write (Enterprise for variables)

FIGMA_ACCESS_TOKEN=figd_your_token_here
# From file URL: https://www.figma.com/design/THIS_PART_IS_FILE_KEY/...
FIGMA_FILE_KEY=your_file_key_here
